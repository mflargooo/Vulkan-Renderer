#version 450

/*
struct Vertex {
    vec3 position;
    vec3 normal;
    vec4 tangent;
    vec2 texCoord;
};
*/
layout(set=0, binding=0) buffer Vertices {
    float vertices[]; // num voxels * (max tris per voxel 16-byte aligned)
};

struct VkDrawIndirectCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};
layout(set=0, binding=1) buffer Voxels {
    VkDrawIndirectCommand vertices_per_voxel[];
};

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

vec3 lut_quad[6] = {
    vec3(-1.0, -1.0, 0.0),
    vec3(1.0, -1.0, 0.0),
    vec3(1.0, 1.0, 0.0),

    vec3(-1.0, -1.0, 0.0),
    vec3(1.0, 1.0, 0.0),
    vec3(-1.0, 1.0, 0.0),
};

void main() {
    uvec3 workgroup_dims = gl_NumWorkGroups; // grid of chunks
    uvec3 chunk_dims = gl_WorkGroupSize; // grid of voxels
    uvec3 global_voxel_id = gl_GlobalInvocationID; // voxel id in full chunk
    uvec3 local_voxel_id = gl_LocalInvocationID; // voxel id in local 8x8x8 workgroup
    uvec3 terrain_dims = chunk_dims * workgroup_dims; // full chunk dims

    uint flat_g_voxel_start = 
        global_voxel_id.x * (terrain_dims.y * terrain_dims.z) +
        global_voxel_id.y * terrain_dims.z +
        global_voxel_id.z;
    uint vertex_count = 6;

    for (uint i = 0; i < 6; ++i) {
        // 16 consecutive vertices belong to this id
        uint byte_start = 12 * (16 * flat_g_voxel_start + i);

        // position
        vertices[byte_start + 0] = lut_quad[i].x;
        vertices[byte_start + 1] = lut_quad[i].y;
        vertices[byte_start + 2] = lut_quad[i].z;

        // normal
        vertices[byte_start + 3] = 0.0;
        vertices[byte_start + 4] = 0.0;
        vertices[byte_start + 5] = 1.0;

        // tangent
        vertices[byte_start + 6] = 1.0;
        vertices[byte_start + 7] = 0.0;
        vertices[byte_start + 8] = 0.0;
        vertices[byte_start + 9] = 1.0;

        // texCoord
        vertices[byte_start + 10] = lut_quad[i].x * 0.5 + 0.5;
        vertices[byte_start + 11] = lut_quad[i].y * 0.5 + 0.5;
    }

    vertices_per_voxel[flat_g_voxel_start].vertexCount = vertex_count;
    vertices_per_voxel[flat_g_voxel_start].instanceCount = 1;
    vertices_per_voxel[flat_g_voxel_start].firstVertex = 16 * flat_g_voxel_start;
    vertices_per_voxel[flat_g_voxel_start].firstInstance = 0;
}

