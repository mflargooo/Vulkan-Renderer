#version 450

#include "mc_lut.glsl"

/*
struct Vertex {
    vec3 position;
    vec3 normal;
    vec4 tangent;
    vec2 texCoord;
};
*/
layout(set=0, binding=0) buffer Vertices {
    float vertices[]; 
};

struct VkDrawIndirectCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};
layout(set=0, binding=1) buffer Chunks {
    // pass 0: vertexCount collects size for allocating tight vertex buffer per chunk
    // pass 1: after allocation, vertexCount is used as index for next triangle vertices 
    VkDrawIndirectCommand vertices_per_chunk[];
};

layout(push_constant) uniform Constants {
    vec3 chunk_center;
    uint chunk_id;
    uint pass_id;

    uint octaves;
    float frequency;
    float amplitude;
} pc;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

#include "noise.glsl"

float density(vec3 position) {
    float d = 0.0;
    float f = pc.frequency;
    float a = pc.amplitude;
    for (uint i = 0; i < pc.octaves; ++i) {
        d += cnoise(position.xy * f) * a;
        f *= 2;
        a *= 0.5;
    }

    return d - position.z;
}

void count_vertices_per_chunk() {
    uvec3 global_voxel_id = gl_GlobalInvocationID; // voxel id in full chunk
    uvec3 local_voxel_id = gl_LocalInvocationID; // voxel id in local 8x8x8 workgroup
    uvec3 chunk_dims = gl_WorkGroupSize * gl_NumWorkGroups; // dimension of chunk in voxels

    vec3 voxel_pos_chunk_space = vec3(global_voxel_id);
    vec3 voxel_pos_world_space = voxel_pos_chunk_space + pc.chunk_center;

    uint cube_case = 0;
    float densities[8];
    for (uint i = 0; i < 8; ++i) {
        densities[i] = density(corners[i] + voxel_pos_world_space);
        if (densities[i] < 0.0) cube_case |= (1 << i);
    }
    
    uint vertex_count = 0;
    for (uint i = 0; i < 15; i+=3) { // place triangles
        int e0 = tri_look_up(cube_case, i);
        if (e0 == -1) break;
        vertex_count += 3;
    }

    atomicAdd(vertices_per_chunk[pc.chunk_id].vertexCount, vertex_count);
}

// inspired by https://www.youtube.com/watch?v=eKN8vz9YZEQ
void compute_mesh() {
    uvec3 global_voxel_id = gl_GlobalInvocationID; // voxel id in full chunk
    uvec3 local_voxel_id = gl_LocalInvocationID; // voxel id in local 8x8x8 workgroup
    uvec3 chunk_dims = gl_WorkGroupSize * gl_NumWorkGroups; // dimension of chunk in voxels

    vec3 voxel_pos_chunk_space = vec3(global_voxel_id);
    vec3 voxel_pos_world_space = voxel_pos_chunk_space + pc.chunk_center;

    uint cube_case = 0;
    float densities[8];
    for (uint i = 0; i < 8; ++i) {
        densities[i] = density(corners[i] + voxel_pos_world_space);
        if (densities[i] < 0.0) cube_case |= (1 << i);
    }
    
    for (uint i = 0; i < 15; i+=3) { // place triangles
        int e0 = tri_look_up(cube_case, i);
        if (e0 == -1) break;
        int e1 = tri_look_up(cube_case, i+1);
        int e2 = tri_look_up(cube_case, i+2);

        int edges[3] = { e0, e1, e2 };

        uint vertex_start = atomicAdd(vertices_per_chunk[pc.chunk_id].vertexCount, 3);
        for (uint j = 0; j < 3; ++j) {
            int e = edges[j];
            uint u = edge_vertex_ids[e][0];
            uint v = edge_vertex_ids[e][1];

            vec3 pu = voxel_pos_chunk_space + vec3(corners[u]);
            vec3 pv = voxel_pos_chunk_space + vec3(corners[v]);

            float du = densities[u];
            float dv = densities[v];

            // interpolation by density values 
            // normals by central difference
            // src - https://paulbourke.net/geometry/polygonise/
            float t = (0.0 /* isolevel */ - du) / (dv - du);
            vec3 p = mix(pu, pv, t);
            vec3 n = normalize(
                vec3(
                    density(p + pc.chunk_center - vec3(1.0, 0.0, 0.0)) - density(p + pc.chunk_center + vec3(1.0, 0.0, 0.0)),
                    density(p + pc.chunk_center - vec3(0.0, 1.0, 0.0)) - density(p + pc.chunk_center + vec3(0.0, 1.0, 0.0)),
                    density(p + pc.chunk_center - vec3(0.0, 0.0, 1.0)) - density(p + pc.chunk_center + vec3(0.0, 0.0, 1.0))
                )
            );

            uint float_start = 12 * (vertex_start + j);

            // position
            vertices[float_start + 0] = p.x;
            vertices[float_start + 1] = p.y;
            vertices[float_start + 2] = p.z;

            // normal
            vertices[float_start + 3] = n.x;
            vertices[float_start + 4] = n.y;
            vertices[float_start + 5] = n.z;

            // TODO: tangent
            vertices[float_start + 6] = 1.0;
            vertices[float_start + 7] = 0.0;
            vertices[float_start + 8] = 0.0;
            vertices[float_start + 9] = 1.0;

            // TODO: tex coord
            vertices[float_start + 10] = 0.5;
            vertices[float_start + 11] = 0.5;
        }
    }
}

void main() {
    if(pc.pass_id == 0) {
        count_vertices_per_chunk();
    } else if (pc.pass_id == 1) {
        compute_mesh();
    }
}

