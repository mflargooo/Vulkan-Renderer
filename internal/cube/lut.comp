#version 450

#include "../../ggx.glsl"

layout(set = 0, binding = 0, rg16f) uniform restrict writeonly image2D result;

layout(local_size_x=8, local_size_y=8, local_size_z=1) in;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    vec2 size = imageSize(result); 
    if (px.x >= size.x || px.y >= size.y) return;

    float roughness = (px.x + .5) / float(size.x);
    float NoV = (px.y + .5) / float(size.y);

    vec3 V = vec3( sqrt(1.f - NoV * NoV), 0, NoV );
    float A = 0;
    float B = 0;

    const uint samples = 1024u;
    for (uint i = 0; i < samples; ++i) {
        vec2 xi = hammersley( i, samples );
        vec3 H = importance_sample_ggx( xi, roughness, vec3(0.0, 0.0, 1.0) );
        vec3 L = 2 * dot(V, H) * H - V;

        float NoL = clamp( L.z, 0.0, 1.0 );
        float NoH = clamp( H.z, 0.0, 1.0 );
        float VoH = clamp( dot(V, H), 0.0, 1.0 );

        if (NoL > 0.0) {
            float G = G_smith( roughness, NoV, NoL );
            float G_vis = G * VoH / (NoH * NoV);
            float OneMinVoH = 1 - VoH;
            float Fc =  OneMinVoH * OneMinVoH * OneMinVoH * OneMinVoH * OneMinVoH;
            A += (1 - Fc) * G_vis;
            B += Fc * G_vis;
        }
    }

    imageStore(result, px, vec4( A, B, 0.0, 0.0 ) / samples);
}