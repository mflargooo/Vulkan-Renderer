#version 450

layout (set = 0, binding = 0) uniform samplerCube environment;

layout(set = 1, binding = 0, std140) uniform OutFace {
    mat3x3 WORLD_FROM_OUT_PX;
};
layout(set = 1, binding = 1, rgba32f) uniform restrict image2D outFace;

layout(set = 2, binding = 2) uniform Params {
    float roughness;
};

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "../../ggx.glsl"

void main() {
    int out_x = int(gl_GlobalInvocationID.x);
    int out_y = int(gl_GlobalInvocationID.y);

    if (out_x >= imageSize(outFace).x || out_y >= imageSize(outFace).y) return;

    vec3 R = normalize(WORLD_FROM_OUT_PX * vec3(vec2(out_x, out_y), 1.0));

    // prefilter per https://blog.selfshadow.com/publications/s2013-shading-course/karis/s2013_pbs_epic_notes_v2.pdf
    vec3 N = R;
    vec3 V = R;

    float weight = 0.0;
    vec3 prefiltered_color = vec3(0.0);
    const uint samples = 1024u;
    for (uint i = 0u; i < samples; i++) {
        vec2 xi = hammersley( i, samples );
        vec3 H = importance_sample_ggx( xi, roughness, N );
        vec3 L = normalize(2.0 * dot(V, H) * H - V);

        float NoL = clamp( dot( N, L ), 0.0, 1.0 );
        if ( NoL > 0.0 ) {
            prefiltered_color += textureLod(environment, L, 0.0).rgb * NoL;
            weight += NoL;
        }
    }

    vec3 final_color = prefiltered_color / max(weight, 0.0001);
    imageStore(outFace, ivec2(out_x, out_y), vec4(min(final_color, 65408), 1.0));
}