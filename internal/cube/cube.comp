#version 450

precision highp float;
precision highp int;

layout (set = 0, binding = 0) uniform samplerCube environment;

layout(set = 1, binding = 0, std140) uniform OutFace {
    mat3x3 WORLD_FROM_OUT_PX;
};
layout(set = 1, binding = 1, rgba32f) uniform restrict image2D outFace;

layout(set = 2, binding = 2) uniform Params {
    int face_id;
    float roughness;
};

layout(local_size_x = 8, local_size_y = 8) in;

// https://holger.dammertz.org/stuff/notes_HammersleyOnHemisphere.html
float radical_inverse_VdC(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 hammersley(uint i, uint n) {
    return vec2(float(i) / float(n), radical_inverse_VdC(i));
}

// https://blog.selfshadow.com/publications/s2013-shading-course/karis/s2013_pbs_epic_notes_v2.pdf
vec3 importance_sample_ggx(vec2 xi, float roughness, vec3 normal) {
    float a = roughness * roughness;
    float phi = 2.0 * 3.14159265359 * xi.x;

    float cos_theta = sqrt( (1.0 - xi.y) / (1.0 + (a * a - 1.0) * xi.y) );
    float sin_theta = sqrt( 1.0 - cos_theta * cos_theta );

    vec3 h;
    h.x = sin_theta * cos(phi);
    h.y = sin_theta * sin(phi);
    h.z = cos_theta;

    vec3 up = abs(normal.z) < .999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent_x = normalize( cross( up, normal ) );
    vec3 tangent_y = normalize( cross( normal, tangent_x ) );
    return normalize(tangent_x * h.x + tangent_y * h.y + normal * h.z);
} 

float D( float NoH, float roughness ) {
    float a = roughness * roughness;
    float a2 = a * a;
    float c = (NoH * NoH * (a2 - 1.0) + 1.0);
    return a2 / (3.14159265359 * c * c);
}

float solid_angle( vec2 uv, vec2 size ) {
    return 4 / (pow(1.0 + uv.x * uv.x + uv.y * uv.y, 1.5) * size.x * size.y);
}

vec3 direction_from_texcoords(float cx, float cy, int face) {
    vec3 dir;
    if (face == 0) { // +x
        dir = vec3(1.f, -cy, -cx); // rotated cw 90
    } else if (face == 1) { // -x
        dir = vec3(-1.f, -cy, cx); // rotated ccw 90
    } else if (face == 2) { // +y
        dir = vec3(cx, 1.f, cy); // already up-right
    } else if (face == 3) { // -y
        dir = vec3(cx, -1.f, -cy); // rotated 180 deg
    } else if (face == 4) { // +z
        dir = vec3(cx, -cy, 1.f);
    } else if (face == 5) { // -z
        dir = vec3(cx, -cy, -1.f);
    }

    return normalize(dir);
}

void main() {
    int out_x = int(gl_GlobalInvocationID.x);
    int out_y = int(gl_GlobalInvocationID.y);

    vec3 R = normalize(WORLD_FROM_OUT_PX * vec3(vec2(out_x, out_y), 1.0));

    // prefilter per https://blog.selfshadow.com/publications/s2013-shading-course/karis/s2013_pbs_epic_notes_v2.pdf
    vec3 N = R;
    vec3 V = R;

    float weight = 0.0;
    vec3 prefiltered_color = vec3(0.0);

    vec2 map_size = textureSize(environment, 0);
    for (int x = 0; x < map_size.x; ++x) {
        for (int y = 0; y < map_size.y; ++y) {
            vec2 uv = ((vec2(x, y) + .5) * 2.0 - 1.0) / map_size;
            vec3 L = direction_from_texcoords( uv.x, uv.y, face_id );
            float NoL = max(dot(N, L), 0.0);

            if (NoL <= 0.0) continue;

            vec3 H = normalize(L + V);
            float NoH = max(dot(N, H), 0.0);
            float VoH = max(dot(N, H), 0.0);

            if ( NoH > 0.0 && VoH > 0.0 ) {
                float d = D( NoH, roughness );
                float sa = solid_angle( uv, map_size );
                vec3 Li = textureLod(environment, L, 0.0).rgb;
                float pdf = (d * NoH) / (4 * VoH);
                float w = sa * NoL / pdf;
                prefiltered_color += Li * w;
                weight += w;
            }
        }
    }

    vec3 final_color = prefiltered_color / max(weight, 1e-4);
    imageStore(outFace, ivec2(out_x, out_y), vec4(final_color, 1.0));
}